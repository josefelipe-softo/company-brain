{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "company-brain-deploy",
	"main": "src/worker.ts",
	"compatibility_date": "2025-06-22",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env",
		"enable_ctx_exports"
	],
	"minify": true,
	"build": {
		"command": "bun run build:web",
		"watch_dir": ["src", "web"]
	},
	"assets": {
		"directory": "./dist/web",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/brain/*",
			"/slack/*",
			"/auth/*",
			"/setup",
			"/setup/*",
			"/health"
		]
	},
	// Variáveis editadas no painel da Cloudflare (ex.: AUDIENCE_MCP_HOSTS)
	// sobrevivem aos deploys do Git.
	"keep_vars": true,
	// Mantém o endereço *.workers.dev ligado a cada deploy.
	"workers_dev": true,
	"vars": {
		// "on" once the Workers Paid block below is enabled: sandbox tools then
		// run on a Cloudflare container.
		"CONTAINER_SANDBOX": "off",
		// The sandbox SDK's RPC transport; artifact downloads stream over it.
		"SANDBOX_TRANSPORT": "rpc",
		// AUDIENCE_MCP_HOSTS (hosts of MCP servers that enforce Slack audience
		// permissions, e.g. the company wiki) is set in the Cloudflare dashboard,
		// not here: a value in this file would overwrite it on every Git deploy.
		// "off" keeps supermemory read-only: nothing from Slack is written there.
		"BRAIN_MEMORY_WRITES": "off"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "company-brain",
			"database_id": "90c4afa5-0133-43b9-b99c-e4a62f07c6e6",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "BRAIN_KV",
			"id": "7adf289adc0a42378ab5aee9005c4e51"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "COMPANY_BRAIN_AGENT",
				"class_name": "CompanyBrainAgent"
			},
			{
				"name": "Sandbox",
				"class_name": "Sandbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CompanyBrainAgent"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Sandbox"
			]
		}
	],
	// ── Workers Paid ($5/mo) ─────────────────────────────────────────────────
	// The brain runs on the free plan. On Workers Paid, uncomment this block
	// and set CONTAINER_SANDBOX to "on" above to give it a built-in container
	// sandbox (shell, git, Python). Without it, sandbox tools use Daytona when
	// DAYTONA_API_KEY is set.
	//
	// "containers": [
	// 	{
	// 		"class_name": "Sandbox",
	// 		"image": "./sandbox/Dockerfile",
	// 		"instance_type": "basic",
	// 		"max_instances": 10
	// 	}
	// ],
	"unsafe": {
		"bindings": [
			{
				"type": "ratelimit",
				"name": "GMAIL_FETCH_RATE_LIMITER",
				"namespace_id": "1101",
				"simple": {
					"limit": 150,
					"period": 10
				}
			},
			{
				"type": "ratelimit",
				"name": "GRANOLA_FETCH_RATE_LIMITER",
				"namespace_id": "1102",
				"simple": {
					"limit": 25,
					"period": 10
				}
			}
		]
	}
}
